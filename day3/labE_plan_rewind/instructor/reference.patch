@@ -12,5 +12,16 @@ class TodoService:
     def list_todos(self) -> List[Todo]:
         return self.repo.load()
 
+    def add_todo(self, title) -> Todo:
+        """新增待辦；標題不合法時拋出 ValueError（訊息即錯誤原因）。"""
+        error = validate_title(title)
+        if error:
+            raise ValueError(error)
+        todos = self.repo.load()
+        todo = Todo(id=max((t.id for t in todos), default=0) + 1, title=title.strip())
+        todos.append(todo)
+        self.repo.save(todos)
+        return todo
+
