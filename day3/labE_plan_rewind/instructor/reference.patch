@@ -30,6 +30,26 @@ class Handler(BaseHTTPRequestHandler):
         self.end_headers()
         self.wfile.write(body)
 
+    def do_POST(self):
+        if self.path != "/api/todos":
+            self.send_json(404, {"error": "找不到路徑"})
+            return
+        try:
+            length = int(self.headers.get("Content-Length", 0))
+            data = json.loads(self.rfile.read(length).decode("utf-8"))
+        except (ValueError, UnicodeDecodeError):
+            self.send_json(400, {"error": "請求內容必須是 JSON"})
+            return
+        if not isinstance(data, dict):
+            self.send_json(400, {"error": "請求內容必須是 JSON 物件"})
+            return
+        try:
+            todo = service.add_todo(data.get("title"))
+        except ValueError as e:
+            self.send_json(400, {"error": str(e)})
+            return
+        self.send_json(201, todo.to_dict())
+
     def do_GET(self):
         if self.path == "/api/health":
             self.send_json(200, {"status": "ok"})
