+class TestPostTodosApi(unittest.TestCase):
+    def setUp(self):
+        from src.ui import server
+        self.tmp = tempfile.TemporaryDirectory()
+        self.server_mod = server
+        self.orig_service = server.service
+        server.service = TodoService(JsonTodoRepo(str(pathlib.Path(self.tmp.name) / "t.json")))
+        self.httpd = ThreadingHTTPServer(("127.0.0.1", 0), server.Handler)
+        threading.Thread(target=self.httpd.serve_forever, daemon=True).start()
+        self.base = f"http://127.0.0.1:{self.httpd.server_address[1]}"
+
+    def tearDown(self):
+        self.httpd.shutdown()
+        self.httpd.server_close()
+        self.server_mod.service = self.orig_service
+        self.tmp.cleanup()
+
+    def post(self, raw: bytes):
+        req = urllib.request.Request(
+            self.base + "/api/todos", data=raw, method="POST",
+            headers={"Content-Type": "application/json"})
+        try:
+            with urllib.request.urlopen(req) as resp:
+                return resp.status, json.loads(resp.read())
+        except urllib.error.HTTPError as e:
+            return e.code, json.loads(e.read())
+
+    def test_create_returns_201(self):
+        status, body = self.post(json.dumps({"title": " 買牛奶 "}, ensure_ascii=False).encode())
+        self.assertEqual(status, 201)
+        self.assertEqual(body, {"id": 1, "title": "買牛奶", "done": False, "due": None})
+        with urllib.request.urlopen(self.base + "/api/todos") as resp:
+            self.assertEqual(len(json.loads(resp.read())), 1)
+
+    def test_invalid_returns_400_with_error(self):
+        for raw in [b'{"title": "   "}', b'{}', b'{"title": 5}',
+                    json.dumps({"title": "字" * 101}).encode(),
+                    b'not json', b'[]']:
+            status, body = self.post(raw)
+            self.assertEqual(status, 400, raw)
+            self.assertTrue(body["error"], raw)
+
 
 if __name__ == "__main__":
     unittest.main()
